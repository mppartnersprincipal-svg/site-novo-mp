# Webhook que recebe os leads do formulário de diagnóstico (Kommo/Make/Zapier/etc.)
# Sem essa variável, os leads ficam apenas no log do servidor (Vercel Functions).
DIAGNOSTICO_WEBHOOK_URL=

# Google Tag Manager (ex.: GTM-XXXXXXX). Vazio = script não é injetado.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel (só números). Vazio = script não é injetado.
NEXT_PUBLIC_META_PIXEL_ID=
